<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.RemedioCerto" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- T01 - Splash: ícone do app sobre a cor primária enquanto a sessão é carregada.
         Depois o Android troca para o tema normal (postSplashScreenTheme). -->
    <style name="Theme.RemedioCerto.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F766E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RemedioCerto</item>
    </style>
</resources>