APP_NAME="Remedio Certo API"
APP_VERSION="2.0.0"
DATABASE_URL="sqlite:///./remedio_certo_dev.db"
SECRET_KEY="troque_esta_chave_por_uma_chave_grande_e_segura"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=15
ENVIRONMENT=development
CREATE_TABLES_ON_STARTUP=true
ALLOW_ORIGINS="*"

# E-mail: preferir HTTPS para Render Free; configurar remetente verificado.
RESEND_API_KEY=""
EMAIL_FROM=""
# Alternativa SMTP STARTTLS (nao acessivel no Render Free).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_STARTTLS=true

# JSON completo da service account apenas no ambiente seguro do servidor.
FIREBASE_CREDENTIALS_JSON=""
ALERTS_ENABLED=true
ALERTS_INTERVAL_SECONDS=60
TIMEZONE="America/Sao_Paulo"
